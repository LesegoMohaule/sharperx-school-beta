# Existing SharperTime API used for auth, speech transcription, and tutor turns.
SHARPERTIME_API_BASE_URL=https://api.46.225.173.118.nip.io

# Exact browser origins allowed to start a voice session.
VOICE_ALLOWED_ORIGINS=https://sharperx.co.za,https://www.sharperx.co.za,http://localhost:5500,http://127.0.0.1:5500

# Optional STUN entries. Format: JSON array accepted by aiortc, for example:
# PIPECAT_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# TURN uses server-generated short-lived credentials and should not be configured here.
PIPECAT_ICE_SERVERS=

# Set these together when coturn is installed. The app receives expiring credentials
# from /session; never put the shared secret in the static web app.
TURN_SERVER_URLS=turn:api.46.225.173.118.nip.io:3478?transport=udp,turn:api.46.225.173.118.nip.io:3478?transport=tcp,turns:api.46.225.173.118.nip.io:5349?transport=tcp
TURN_SHARED_SECRET=

VOICE_HOST=127.0.0.1
VOICE_PORT=7860
HF_HOME=/opt/sharpertime-voice/models/huggingface
SHARPERTIME_ASR_MODEL_DIR=/opt/sharpertime-voice/models
SHARPERTIME_ASR_CPU_THREADS=2
PIPECAT_LOG_LLM_CONTEXT=off
PIPECAT_LOG_LEVEL=INFO
