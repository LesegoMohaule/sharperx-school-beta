# Replace the addresses and realm if the server changes.
listening-ip=46.225.173.118
relay-ip=46.225.173.118
external-ip=46.225.173.118
listening-port=3478
tls-listening-port=5349
min-port=21000
max-port=21999
realm=api.46.225.173.118.nip.io
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_64_HEX_CHAR_SECRET
cert=/etc/turnserver/tls/fullchain.pem
pkey=/etc/turnserver/tls/privkey.pem
no-loopback-peers
no-multicast-peers
no-cli
user-quota=8
total-quota=200
